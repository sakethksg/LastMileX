# ==============================================================================
# LastMileX Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE VARIABLES (Exposed to browser bundle via NEXT_PUBLIC_ prefix)
# ------------------------------------------------------------------------------

# Public Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Public Supabase Anonymous Key (safe for browser client auth session handling)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Canonical Base URL of the Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER expose to browser bundles)
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Server-authoritative database and admin access)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# PostgreSQL Database URLs (via Supabase / PgBouncer)
# Connection pooler URL for runtime serverless / Next.js functions
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct PostgreSQL connection URL for Prisma schema migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Runtime Environment ("development" | "test" | "production")
NODE_ENV="development"


# ------------------------------------------------------------------------------
# 3. OPTIONAL NOTIFICATION PROVIDER SECRETS (Server-Only)
# ------------------------------------------------------------------------------
# In-memory mock notification delivery is used if these are omitted.

RESEND_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
